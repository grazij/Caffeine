"Turn on ${applicationName}" = "Ligar ${applicationName}";
"Disable ${applicationName}" = "Desativar ${applicationName}";
"Turn off ${applicationName}" = "Desligar ${applicationName}";
"Toggle ${applicationName}" = "Alternar ${applicationName}";
